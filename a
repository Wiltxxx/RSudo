#!/usr/bin/env bash
# doc2md —— Doc 语法转 Markdown（纯 Bash 实现）
# 用法:
#   doc2md in.doc out.md
#   doc2md in.doc            # 输出到 stdout
#   doc2md < in.doc          # 从 stdin 读
#   doc2md - out.md
set -euo pipefail

usage() {
  cat <<'EOF'
用法: doc2md [输入] [输出]
  输入/输出为 "-" 或缺省时表示 stdin/stdout
示例:
  doc2md spec.doc spec.md
  doc2md spec.doc
  cat spec.doc | doc2md > spec.md
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

IN="${1:--}"
OUT="${2:--}"

# 打开输入输出（fd 3 / 4），避免污染 stdin/stdout
if [[ "$IN" == "-" ]]; then
  exec 3<&0
else
  [[ -r "$IN" ]] || { echo "doc2md: 无法读取 $IN" >&2; exit 1; }
  exec 3<"$IN"
fi
if [[ "$OUT" == "-" ]]; then
  exec 4>&1
else
  exec 4>"$OUT"
fi

# ---------- 行内转换 ----------
# 控制字符占位：
#   \x11..\x16 分别对应转义后的 @ % ^ ~ { }
#   \x10N\x10  行内代码占位
inline() {
  local s=$1
  local pre rest mid post out idx
  local -a codes=()

  # 1) 转义占位
  s=${s//\\@/$'\x11'}
  s=${s//\\%/$'\x12'}
  s=${s//\\^/$'\x13'}
  s=${s//\\~/$'\x14'}
  s=${s//\\{/$'\x15'}
  s=${s//\\}/$'\x16'}

  # 2) 行内代码保护
  local lb='{{' rb='}}'
  while [[ $s == *"$lb"*"$rb"* ]]; do
    pre=${s%%"$lb"*}
    rest=${s#*"$lb"}
    mid=${rest%%"$rb"*}
    post=${rest#*"$rb"}
    codes+=("$mid")
    s="${pre}"$'\x10'"${#codes[@]}"$'\x10'"${post}"
  done

  # 3) 图片 %![alt](url)
  while [[ $s =~ %\!\[([^][]*)\]\(([^()]*)\) ]]; do
    s=${s/"${BASH_REMATCH[0]}"/"![${BASH_REMATCH[1]}](${BASH_REMATCH[2]})"}
  done

  # 4) 链接 %[text](url)
  while [[ $s =~ %\[([^][]*)\]\(([^()]*)\) ]]; do
    s=${s/"${BASH_REMATCH[0]}"/"[${BASH_REMATCH[1]}](${BASH_REMATCH[2]})"}
  done

  # 5) 删除线 ^^...^^
  while [[ $s =~ \^\^([^^]*)\^\^ ]]; do
    s=${s/"${BASH_REMATCH[0]}"/"~~${BASH_REMATCH[1]}~~"}
  done

  # 6) 粗体 %%...%%
  while [[ $s =~ %%([^%]*)%% ]]; do
    s=${s/"${BASH_REMATCH[0]}"/"**${BASH_REMATCH[1]}**"}
  done

  # 7) 斜体 ~...~
  while [[ $s =~ ~([^~]*)~ ]]; do
    s=${s/"${BASH_REMATCH[0]}"/"*${BASH_REMATCH[1]}*"}
  done

  # 8) 还原行内代码
  out=""
  while [[ $s =~ ^([^[:cntrl:]]*)$'\x10'([0-9]+)$'\x10'(.*)$ ]]; do
    idx=$(( BASH_REMATCH[2] - 1 ))
    out+="${BASH_REMATCH[1]}"'`'"${codes[$idx]}"'`'
    s=${BASH_REMATCH[3]}
  done
  s="${out}${s}"

  # 9) 还原转义
  s=${s//$'\x11'/@}
  s=${s//$'\x12'/%}
  s=${s//$'\x13'/^}
  s=${s//$'\x14'/~/}
  s=${s//$'\x15'/{}
  s=${s//$'\x16'/}}

  printf '%s' "$s"
}

# ---------- 逐行状态机 ----------
in_code=0
line=""

while IFS= read -r line <&3 || [[ -n "$line" ]]; do
  line=${line%$'\r'}

  # 代码块内：只认 @endcode
  if (( in_code )); then
    if [[ $line =~ ^[[:space:]]*@endcode[[:space:]]*$ ]]; then
      printf '```\n' >&4
      in_code=0
    else
      printf '%s\n' "$line" >&4
    fi
    continue
  fi

  # 代码块开始 @code [lang]
  if [[ $line =~ ^[[:space:]]*@code([[:space:]]+([^[:space:]]+))?[[:space:]]*$ ]]; then
    printf '```%s\n' "${BASH_REMATCH[2]:-}" >&4
    in_code=1
    continue
  fi

  # 分割线 @--
  if [[ $line =~ ^[[:space:]]*@--[[:space:]]*$ ]]; then
    printf -- '---\n' >&4
    continue
  fi

  # 标题 @ @@ ... @@@@@@
  if [[ $line =~ ^([[:space:]]*)(@+)([[:space:]]+(.*))?$ ]]; then
    indent=${BASH_REMATCH[1]}
    ats=${BASH_REMATCH[2]}
    content=${BASH_REMATCH[4]:-}
    n=${#ats}
    (( n > 6 )) && n=6
    hashes=$(printf '%*s' "$n" '' | tr ' ' '#')
    printf '%s%s %s\n' "$indent" "$hashes" "$(inline "$content")" >&4
    continue
  fi

  # 有序列表 @1. 内容
  if [[ $line =~ ^([[:space:]]*)@([0-9]+)\.[[:space:]]+(.*)$ ]]; then
    printf '%s%s. %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "$(inline "${BASH_REMATCH[3]}")" >&4
    continue
  fi

  # 无序列表 @- 内容
  if [[ $line =~ ^([[:space:]]*)@-[[:space:]]+(.*)$ ]]; then
    printf '%s- %s\n' "${BASH_REMATCH[1]}" "$(inline "${BASH_REMATCH[2]}")" >&4
    continue
  fi

  # 引用 @> / @>> ...
  if [[ $line =~ ^([[:space:]]*)@(>+)[[:space:]]+(.*)$ ]]; then
    prefix=""
    for ((i=0; i<${#BASH_REMATCH[2]}; i++)); do prefix+="> "; done
    printf '%s%s\n' "${prefix}" "$(inline "${BASH_REMATCH[3]}")" >&4
    continue
  fi

  # 表格行 @| ...
  if [[ $line =~ ^([[:space:]]*)@\|(.*)$ ]]; then
    printf '%s|%s\n' "${BASH_REMATCH[1]}" "$(inline "${BASH_REMATCH[2]}")" >&4
    continue
  fi

  # 普通行
  printf '%s\n' "$(inline "$line")" >&4
done

# 代码块未闭合则补上
if (( in_code )); then
  printf '```\n' >&4
fi

exec 3<&-
exec 4>&-